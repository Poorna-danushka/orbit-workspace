PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key

# Exact allowed browser origins, comma-separated. Never use "*" for authenticated APIs.
# Replace these development origins with the deployed frontend origin(s) in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Single frontend origin used for invitation and reset links.
CLIENT_URL=http://localhost:3000

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_app_password
MAIL_FROM=you@example.com

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# One-time admin bootstrap (never commit real values)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Google OAuth 2.0 / OIDC (backend only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
